pkgname=mcc
pkgver=0.9.0
pkgrel=9
pkgdesc="mcc compiler collection build systems"
arch=("x86_64")
depends=("glibc" "gcc" "mingw-w64-gcc" "zip" "tar" "gzip" "curl" "github-cli" "libarchive")
options=('!debug')
makedepends=("tar" "git")

source=('git+https://github.com/Mediocre-Games-United/mcc.git' 'bin.tar.gz::https://github.com/Mediocre-Games-United/mcc/releases/download/v0.9.0/mcc-release-v0.9.0-linux64-x86_64.tar.gz')
sha256sums=('SKIP' 'SKIP')

package() {
    cd $srcdir
    tar -xzf bin.tar.gz
    rm -rf "export/lib"

    install -d "$pkgdir/usr/share/mcc"
    cp -a "export/." "$pkgdir/usr/share/mcc/"

    mkdir -p "$pkgdir/usr/bin"
    cd "$pkgdir/usr/bin"
    ln -s "/usr/share/mcc/mcc" "mcc"

    cd "$srcdir/mcc"
    install -Dm644 "mcc.desktop" "$pkgdir/usr/share/applications/mcc.desktop"
    install -Dm644 "application-x-mcc.xml" "$pkgdir/usr/share/mime/packages/x-mcc.xml"
}
